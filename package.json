{
  "name": "@demomacro/nlptools",
  "version": "0.0.0",
  "private": true,
  "description": "Comprehensive NLP toolkit with high-performance string distance and similarity algorithms",
  "keywords": [
    "algorithms",
    "cosine",
    "edit-distance",
    "fuzzy-matching",
    "jaccard",
    "jaro-winkler",
